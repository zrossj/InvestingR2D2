  create  table "foo"."public"."int_b3_ops__dbt_tmp"
  
  
    as
  
  (
    


WITH final as (
    SELECT *
    FROM 
    "foo"."public"."stg_b3_ops"
)

select
id,
to_date(date_op, 'DD-MM-YYYY') as date_op,
wallet_id,
movement,
market,
to_date(
	case
		when expire_date = '-' then '31-12-2099'
		else expire_date
		end, 
	'DD-MM-YYYY') as date_expiration,
CASE 
	when brokerage_firm = 'XP INVESTIMENTOS CCTVM S/A'
	THEN 1
	WHEN brokerage_firm = 'C6 CORRETORA DE TITULOS E VALORES MOBILIARIOS LTDA'
	THEN 2
    WHEN brokerage_firm = 'SANTANDER CCVM S/A'
    THEN 7
    WHEN brokerage_firm = 'ITAU CV S/A'
    THEN 6
    WHEN brokerage_firm = 'CLEAR CORRETORA - GRUPO XP'
    THEN 5
    WHEN brokerage_firm = 'XP INVESTIMENTOS CCTVM S/A'
    THEN 3
    WHEN brokerage_firm = 'NU INVEST CORRETORA DE VALORES S.A.'
    THEN 4
	END as brokerage_firm_id, -- might need to be modify this part adding more ids (pkeys) for brokerage firms depending in your case; 
case
	when market = 'Mercado Fracionário'
	then SUBSTRING(asset, 1, length(asset)-1)
	else asset		
	END	as asset,
quantity::numeric,
pu::numeric(6,2),
value::numeric(9,2)
from stg_b3_ops

  );
  
