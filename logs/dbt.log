        THEN SPLIT_PART(asset, ' - ', 2)
    WHEN substring(asset, 7) = 'Tesouro'
        THEN asset
    ELSE 
        SPLIT_PART(asset, ' - ', 1)
END as asset, -- mercado normal, ticker na p1 do split. ex: "PINE4 - BANCO PINE"
