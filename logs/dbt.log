	THEN 2
	END as brokerage_firm_id,
case
	when market = 'Mercado Fracionário'
	then SUBSTRING(asset, 1, length(asset)-1)
	else asset
	END	as asset,
quantity::numeric,
pu::numeric(6,2),
value::numeric(9,2)
from stg_b3_ops

  );
  
  
